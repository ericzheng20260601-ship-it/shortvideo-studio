# 复制为 .env 后按需填写；留空全部可用（自动进入本地降级模式）
# 注意：不要把真实密钥提交到仓库。生产推荐在「管理后台 → 云服务器管理」里配置。

# ---- 服务 ----
# 服务端口（容器内固定 3000；宿主端口由 compose 的 PORT 决定），绑定 0.0.0.0
PORT=3000
SV_HOST=0.0.0.0
# 数据目录：SQLite、上传素材、成片、会话密钥。云服务器务必挂载持久化卷
# /app/data 是 Docker 容器内的路径；裸机运行请改成本机绝对路径（不设置时默认 server/data）
SV_DATA_DIR=/app/data
# 初始管理员邮箱（首次初始化时生效）
SV_ADMIN_EMAIL=ericzheng20260601@gmail.com
# 首次初始化且无法从 data/accounts.json 导入时的独立初始密码；留空会随机生成并写入数据目录
# SV_ADMIN_PASSWORD=

# ---- 稳定链接 / HTTPS（多人使用必配）----
# 正式域名，Caddy 会据此自动申请并续期证书；域名需先解析到本机、80/443 可公网访问
# SV_DOMAIN=studio.example.com
# 用 HTTPS 反代时设成 127.0.0.1，让 3000 只监听本机，公网只走 443
SV_BIND_ADDR=0.0.0.0
# 会话签名密钥：首次部署就用 `openssl rand -hex 32` 生成并固定，之后不要改。
# 固定后容器重建 / 卷迁移不会强制所有成员重新登录；改动会使全部已签发令牌失效。
# SV_SECRET=
# HTTPS 站点给会话 Cookie 加 Secure；Caddy 覆盖文件会自动置 1，Nginx 反代请手动设 1
SV_COOKIE_SECURE=0
# 单文件上传上限（MB），与反代的 client_max_body_size / request_body.max_size 保持一致
SV_MAX_UPLOAD_MB=200
# 大视频上传的请求窗口（毫秒）；渲染在后台队列，不受此限制
SV_REQUEST_TIMEOUT_MS=600000

# ---- 数据源（无 TikTok 官方权限时走这一层）----
# 第三方合规数据 API：POST JSON {day,limit,categories,countries}，返回 {items:[...]}
# 契约字段见 server/lib/providers.js 的 normalizeExternalItem
# SV_DATA_APIURL=https://your-provider.example.com/tiktok/trending
# SV_DATA_APIKEY=
# 环境变量命名规则：SV_ + 配置键大写并把点去掉，例如 discover.syncHour -> SV_DISCOVER_SYNCHOUR

# ---- 可选外部模型（不填则使用本地规则引擎 / 占位配音）----
# OpenAI 兼容 /chat/completions
# SV_LLM_BASEURL=https://api.openai.com/v1
# SV_LLM_APIKEY=
# SV_LLM_MODEL=gpt-4o-mini
# SV_ASR_APIURL=
# SV_ASR_APIKEY=
# SV_TTS_APIURL=
# SV_TTS_APIKEY=
# SV_TTS_VOICE=alloy

# ---- 日报推送（企微 / 飞书 / Slack 兼容 Webhook；留空则存站内收件箱）----
# SV_PUSH_WEBHOOKURL=
# SV_PUSH_CHANNEL=wecom

# ---- 运维 ----
# 每日同步小时、日报小时、并发数、僵死任务判定时长（remix.staleMinutes）在管理后台配置
# 时区默认 Asia/Shanghai；渲染依赖系统 ffmpeg，镜像内已安装，裸机部署需自行安装
# SV_FFMPEG_PATH=/usr/bin/ffmpeg
# 容器资源上限（按云主机规格调整；ffmpeg 渲染建议 ≥2 核 / ≥4GB）
# SV_MEM_LIMIT=4g
# SV_CPUS=2
# 备份输出目录与保留份数：npm run backup -- /srv/backups
# SV_BACKUP_DIR=/srv/backups
# SV_BACKUP_KEEP=14
# 重要：cron / 混剪队列在进程内，当前架构只能跑 1 个 studio 实例，请勿 --scale > 1
