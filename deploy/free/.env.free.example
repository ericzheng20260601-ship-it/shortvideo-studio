# 零成本部署模板（形态 F：Oracle Cloud Always Free / ARM，无自有域名）
# 复制为工程根目录 .env 使用；oci-init.sh 会自动从 deploy/.env.production.example 生成同等配置，
# 这份模板供手工部署或迁移时核对。含密钥，切勿提交进仓库。

# ---- 域名 ----
# 不买域名时用免费通配符 DNS：<公网IP 把点换成横杠>.sslip.io（例：studio-1-2-3-4.sslip.io）
# 该服务由第三方提供，仅适合过渡；正式使用建议换成自有域名。
# 不要套 Cloudflare 免费代理 / Tunnel：免费档请求体上限 100MB，会截断 200MB 素材上传。
SV_DOMAIN=<IP 点换横杠>.sslip.io

# ---- 会话密钥（迁移的关键）----
# 从 ① 阶段迁移时，填备份包里 secret.key 的内容，成员才不会被强制重新登录。
# 全新部署则留空由 bootstrap.sh 生成随机值；一旦确定长期不要改。
SV_SECRET=

# ---- 固定链接 / 安全 ----
SV_BIND_ADDR=127.0.0.1
SV_COOKIE_SECURE=1
PORT=3000
SV_HOST=0.0.0.0
SV_TZ=Asia/Shanghai

# ---- 容量（OCI Always Free 为 2 OCPU / 12GB，2026-06 起降配）----
SV_DATA_DIR=/app/data
SV_MAX_UPLOAD_MB=200
SV_REQUEST_TIMEOUT_MS=600000
SV_MEM_LIMIT=6g
SV_CPUS=2
# 2 核实例只能串行渲染：启动后在管理后台把 remix.maxConcurrent 设为 1
# （oci-init.sh 会自动写入数据库配置）

# ---- 备份 ----
# 落宿主机 /srv/backups，不占数据卷；由 oci-init.sh 挂进容器并配 crontab
SV_BACKUP_DIR=/srv/backups
SV_BACKUP_KEEP=14

# ---- 外部服务（可选，不填走本地降级并标注 source=local/demo）----
# SV_DATA_APIURL=
# SV_DATA_APIKEY=
# SV_LLM_BASEURL=
# SV_LLM_APIKEY=
# SV_ASR_APIURL=
# SV_TTS_APIURL=

SV_ADMIN_EMAIL=ericzheng20260601@gmail.com
