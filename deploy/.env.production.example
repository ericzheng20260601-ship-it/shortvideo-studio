# 生产环境模板：复制为工程根目录 .env 后填写，再由 deploy/bootstrap.sh 校验并启动。
# 本机还没有服务器时也可以先填好这份，等机器到位直接拷过去用。
# 注意：.env 含密钥，已在 .gitignore 中，切勿提交到仓库。

# ---- 必填 ----
# 正式域名（A 记录指向云主机；大陆云主机需完成备案并放行 80/443）
SV_DOMAIN=studio.example.com

# 会话签名密钥：bootstrap.sh 首次运行会自动用 openssl rand -hex 32 写入。
# 一旦确定就不要再改，改动会让所有已登录成员重新登录。
SV_SECRET=

# ---- 固定链接 / 安全 ----
# 走 HTTPS 反代后 3000 只监听本机，公网只暴露 80/443
SV_BIND_ADDR=127.0.0.1
SV_COOKIE_SECURE=1
PORT=3000
SV_HOST=0.0.0.0
SV_TZ=Asia/Shanghai

# ---- 数据与容量 ----
# Docker 卷内路径，不要改；裸机才用绝对路径
SV_DATA_DIR=/app/data
# 单文件上限（MB），需 <= Caddyfile 的 request_body.max_size（默认 250MB）
SV_MAX_UPLOAD_MB=200
SV_REQUEST_TIMEOUT_MS=600000
# 容器资源上限，按云主机规格调整（ffmpeg 渲染建议 >= 2 核 / >= 4GB）
SV_MEM_LIMIT=4g
SV_CPUS=2
# 备份目录（宿主机路径）与保留份数
SV_BACKUP_DIR=/srv/backups
SV_BACKUP_KEEP=14

# ---- 可选外部服务：不填则走本地降级，结果会标注 source=local/demo ----
# 第三方合规爆款数据 API（无 TikTok 官方权限时的真实指标来源）
# SV_DATA_APIURL=
# SV_DATA_APIKEY=
# OpenAI 兼容模型 / ASR / TTS
# SV_LLM_BASEURL=
# SV_LLM_APIKEY=
# SV_LLM_MODEL=gpt-4o-mini
# SV_ASR_APIURL=
# SV_TTS_APIURL=
# 日报推送（企微 / 飞书 / Slack 兼容 Webhook）
# SV_PUSH_WEBHOOKURL=

# ---- 初始化账号 ----
# 首次启动从 data/accounts.json 导入，管理员邮箱如下；登录后请立即在头像菜单改密
SV_ADMIN_EMAIL=ericzheng20260601@gmail.com
